# ============================================================
# StudyCompanion —— 学习助手（Windows 桌面版 / 安卓版 / Windows 安装程序）
#
# 本仓库只放三端软件；学习资料（留学咨询、教材、课表）留在本地，不入库。
# ============================================================

# ---- 构建中间产物 ----
StudyCompanionAndroid/build/
StudyCompanionAndroid/_selftest/
StudyCompanionAndroid/*.apk.idsig
StudyCompanionSetup/build/
**/__pycache__/

# ---- 运行时产生的数据（含个人打卡记录，绝不入库）----
StudyCompanion/settings.ini
StudyCompanion/data/progress.tsv
StudyCompanion/data/progress.tsv.selftestbak
StudyCompanion/data/daycache.tsv
StudyCompanion/data/学习记录_*.csv
StudyCompanionAndroid/assets/daycache.tsv
**/学习记录_*.csv

# ---- 自检与临时输出 ----
StudyCompanion/selftest.txt
StudyCompanion/closetest.txt
StudyCompanion/layouttest.txt
StudyCompanion/_*.png
StudyCompanion/_test/
StudyCompanion/ghtest.exe
StudyCompanion/assetprobe.exe
StudyCompanionAndroid/selftest.txt
StudyCompanionAndroid/_*.png
StudyCompanionAndroid/preview/phone-*.png

# ---- 绿色版产物：Windows 只发安装版，这个不再入库 ----
StudyCompanion/StudyCompanion.exe

# ---- 生成物（唯一来源是仓库根目录的 CHANGELOG.md）----
StudyCompanion/CHANGELOG.md
StudyCompanionAndroid/assets/CHANGELOG.md
_release_notes.md

# ---- 系统垃圾 ----
~$*
.DS_Store
Thumbs.db
desktop.ini
